{
  "autoUpdatesChannel": "stable",
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "codex-advisor@my-plugins": true,
    "dart-ls-plugin@my-plugins": true,
    "lua-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "worktrunk@worktrunk": true
  },
  "env": {
    "CLAUDE_CODE_SHELL": "/bin/zsh"
  },
  "extraKnownMarketplaces": {
    "my-plugins": {
      "autoUpdate": true,
      "source": {
        "path": "/Users/antondokusov/.config/claude/marketplace",
        "source": "directory"
      }
    },
    "worktrunk": {
      "source": {
        "repo": "max-sixty/worktrunk",
        "source": "github"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/antondokusov/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "model": "opus[1m]",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(git *)",
      "Bash(fvm flutter *)",
      "Bash(fvm dart *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(pwd)",
      "Bash(xcrun simctl *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(sed *)",
      "Bash(git commit:*)",
      "Bash(xargs ls:*)",
      "Bash(grep:*)",
      "Bash(xargs:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  },
  "preferredNotifChannel": "notifications_disabled",
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "~/.config/claude/statusline.sh",
    "type": "command"
  },
  "theme": "light",
  "tui": "fullscreen",
  "voiceEnabled": true
}