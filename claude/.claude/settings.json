{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SHELL": "/bin/zsh"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(git *)",
      "Bash(fvm flutter *)",
      "Bash(fvm dart *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(pwd)",
      "Bash(xcrun simctl *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(sed *)",
      "Bash(git commit:*)",
      "Bash(xargs ls:*)",
      "Bash(grep:*)",
      "Bash(xargs:*)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.config/claude/statusline.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "dart-ls-plugin@my-plugins": true,
    "superpowers@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
    "typescript-lsp@claude-plugins-official": true,
    "codex-advisor@my-plugins": true
  },
  "extraKnownMarketplaces": {
    "my-plugins": {
      "source": {
        "source": "directory",
        "path": "/Users/antondokusov/.config/claude/marketplace"
      },
      "autoUpdate": true
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    }
  },
  "effortLevel": "xhigh",
  "advisorModel": "opus",
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "preferredNotifChannel": "notifications_disabled",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
